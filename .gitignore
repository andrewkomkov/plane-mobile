android/local.properties
# Only the generated pieces under ios/Flutter. The whole directory used to be
# ignored, which took Debug.xcconfig and Release.xcconfig with it — those are
# checked in on every Flutter project, and without them Xcode cannot open its
# base configuration and a clean clone does not build for iOS at all.
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Pods/
.env
*.apk
*.aab
android/.kotlin/

# Agent worktrees
.claude/worktrees/

# Firebase. Names a specific project; see google-services.json.example.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Signing material. Never belongs in the repository.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
android/key.properties

# Coverage output
coverage/
lcov.info

# MegaLinter
megalinter-reports/

