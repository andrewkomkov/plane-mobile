# Credentials for the integration tests and the demo seeder only.
#
# The app itself needs none of this: it asks for the instance URL and signs you
# in on first launch, and keeps the token in the platform keystore.
#
# Copy to .env, which is git-ignored.

# Your Plane instance, without a trailing slash.
PLANE_BASE_URL=https://plane.example.com

# A Plane API token: Profile settings -> Personal access tokens.
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The workspace the demo seeder writes into. It creates a project there; point
# it at a workspace you do not mind it touching.
PLANE_WORKSPACE_SLUG=my-workspace
