root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
# `dart format` decides; these only stop an editor from fighting it.
max_line_length = 80

[*.{kt,kts,gradle}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
