root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
# `dart format` decides; these only stop an editor from fighting it.
max_line_length = 80

[*.{kt,kts,gradle}]
indent_size = 4

[*.{kt,kts}]
# ktlint reads its rules from here.
max_line_length = 120
ktlint_code_style = intellij_idea
# Compose components are PascalCase; the rule assumes camelCase everywhere.
ktlint_standard_function-naming = disabled
# The Flutter-generated package name carries an underscore and has to match
# the Android applicationId, so it is not ours to rename.
ktlint_standard_package-name = disabled

[*.py]
indent_size = 4

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
