root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
# `dart format` is the only authority on Dart layout, and CI runs it with
# --set-exit-if-changed. A second limit here only creates a disagreement
# neither tool can win — it does not rewrap a comment that formatter leaves at
# 81 columns, it just reports it.
max_line_length = off

[*.{kt,kts,gradle}]
indent_size = 4

[*.{kt,kts}]
# ktlint reads its rules from here.
max_line_length = 120
ktlint_code_style = intellij_idea
# Compose components are PascalCase; the rule assumes camelCase everywhere.
ktlint_standard_function-naming = disabled
# The Flutter-generated package name carries an underscore and has to match
# the Android applicationId, so it is not ours to rename.
ktlint_standard_package-name = disabled
# M3ExpressiveViews.kt holds the factory and the three views it builds. The
# rule wants one class per file, named after it; splitting four small classes
# that only exist together would make them harder to read, not easier.
ktlint_standard_filename = disabled

[*.py]
indent_size = 4

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false
# Indentation in Markdown is semantic, not stylistic: a continuation line
# under "1. " needs three spaces to stay part of that item, and a nested list
# needs to align with its parent's content. Rounding those to a multiple of
# two changes what the document means.
indent_size = unset

[{Makefile,*.mk}]
indent_style = tab

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
